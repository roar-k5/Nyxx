PORT=5000
# MongoDB Atlas (Production)
# Get this from MongoDB Atlas Dashboard -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nyx?retryWrites=true&w=majority

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=groq

# JWT Secret (generate strong one)
JWT_SECRET_KEY=generate_a_strong_random_secret_here

# CORS: Your frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
MAX_CONTENT_LENGTH=1048576
REQUEST_TIMEOUT=30

# Helplines - Configure your own or leave empty for demo placeholders
# Option 1: Full JSON array
# HELPLINES_JSON=[{"name":"Your Helpline","number":"1234567890","available":"24/7"}]

# Option 2: Individual helplines (up to 5)
# HELPLINE_1_NAME=Your Local Helpline
# HELPLINE_1_NUMBER=1234567890
# HELPLINE_1_AVAILABLE=24/7
# HELPLINE_1_NOTE=Free counseling

# Production settings (enable these when deploying)
# ENFORCE_HTTPS=true
# TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com
